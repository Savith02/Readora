# ---- backend: copy these lines into backend/.env ----------------------------------------

# Your local MongoDB. The database (and the accounts in it) is created the first time it is used.
MONGO_URI=mongodb://localhost:27017/readora

# Signs login tokens. It must be at least 32 characters, so make your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Keep 5000: the frontend dev server forwards /api to this port (frontend/vite.config.ts).
PORT=5000

# Password reset emails. Leave these empty in development: the reset link is then printed in
# the backend terminal. For real emails, fill in all three (Gmail: smtp.gmail.com, port 587,
# your address, and an "app password" from your Google account, not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- frontend: optional, goes in frontend/.env ------------------------------------------
# Not needed in development: the dev server already forwards /api to the backend.
# VITE_API_URL=http://localhost:5000/api
